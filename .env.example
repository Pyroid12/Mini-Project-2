# ============================================================
# CareerBuddy AI - Environment Variables Template (.env.example)
# Copy this file to .env.local (frontend) and .env (backend)
# NEVER commit files containing real keys to git!
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Next.js / Vercel)
# ------------------------------------------------------------

# Clerk Authentication (Required)
# Retrieve from: https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Routing (Standard URLs)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in

# Express AI Server URL (Required in production)
# In local development: defaults to http://localhost:3001
# In production on Vercel: set to your deployed backend URL (e.g., https://careerbuddy-ai-server.onrender.com)
AI_SERVER_URL=http://localhost:3001
AI_SERVER_PORT=3001

# Public Frontend Application URL (Production origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# Clerk Webhooks (Optional for dev, required for prod database user sync)
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# External AI Mock Interview Engine URL (Optional)
# If you have a separate mock interview sandbox/engine, set its URL here
NEXT_PUBLIC_MOCK_INTERVIEW_URL=https://ai-mock-interview-platform-tau-eight.vercel.app

# ------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Express Server / Node host)
# ------------------------------------------------------------

# Server Port
PORT=3001
NODE_ENV=production

# Frontend Origin for CORS (e.g., https://your-careerbuddy.vercel.app)
FRONTEND_URL=http://localhost:3000

# Google Gemini API Key (Required for AI resume, roadmap, and insights)
# Keep strictly server-side! Retrieve from: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.8-flash

# Supabase PostgreSQL Connection String (Prisma ORM)
# Transaction pooler connection string (Port 6543) or direct connection (Port 5432)
# Retrieve from: Supabase Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Clerk Secret Key (Backend verification of session tokens)
# Same key as CLERK_SECRET_KEY above
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token (Optional, increases rate limit from 60 to 5000 req/hr)
# Retrieve from: GitHub Settings -> Developer Settings -> Personal Access Tokens (classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
